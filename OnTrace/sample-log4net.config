<?xml version="1.0" encoding="utf-8" ?>
<!--
  Example log4net configuration for OnTrace.

  OnTrace creates three loggers ("AppLogger", "EventLogger" and "StartupLogger" by default,
  overridable via the AppLoggerSelectLogger / EventLoggerSelectLogger / StartupLoggerSelectLogger
  app settings). Give each logger the appender(s) you want.

  GetLogFileName() reads the File parameter of these appenders by default:
    - LogFileAppender            (AppLog)
    - EventlogAppender           (EventLog)
    - StartupLogFileAppender     (StartupLog)
-->
<log4net>
  <appender name="LogFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="{ProgramFolderName}\{ProgramFilename}.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="10" />
    <maximumFileSize value="10MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{ISO8601} %-5level %property{ClassName}.%property{MethodName}() Line:%property{LineNumber} - %message%newline" />
    </layout>
  </appender>

  <appender name="EventlogAppender" type="log4net.Appender.EventLogAppender">
    <logName value="Application" />
    <applicationName value="MyApplication" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%message%newline" />
    </layout>
  </appender>

  <appender name="StartupLogFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="{ProgramFolderName}\{ProgramFilename}.startup.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="5" />
    <maximumFileSize value="5MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{ISO8601} %-5level - %message%newline" />
    </layout>
  </appender>

  <root>
    <level value="ALL" />
  </root>

  <logger name="AppLogger">
    <level value="ALL" />
    <appender-ref ref="LogFileAppender" />
  </logger>

  <logger name="EventLogger">
    <level value="ALL" />
    <appender-ref ref="EventlogAppender" />
  </logger>

  <logger name="StartupLogger">
    <level value="ALL" />
    <appender-ref ref="StartupLogFileAppender" />
  </logger>
</log4net>
